# Copy this file to .env and adjust it. Do NOT commit real secrets
# (.env is gitignored).

# development | staging | production
ENVIRONMENT=development
# debug | info | warn | error (debug also logs every SQL query)
LOG_LEVEL=info

# The HTTP bind address for `just app`. Compose overrides HOST to 0.0.0.0.
HOST=localhost
PORT=8080

# docker-compose uses these host port mappings.
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# The Postgres URL. Use localhost when you run the app on the host
# (`just app`). The compose api service overrides this with the in-network
# hostname.
DATABASE_URL=postgres://app:app@localhost:5432/app
