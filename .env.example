# Copy to .env and adjust. Do NOT commit real secrets (.env is gitignored).

# development | staging | production
ENVIRONMENT=development
# debug | info | warn | error
LOG_LEVEL=info

# HTTP bind address for `just app` (compose overrides HOST to 0.0.0.0)
HOST=localhost
PORT=8080

# Host port mappings used by docker-compose
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Postgres — localhost when running the app on the host (`just app`);
# the compose api service overrides this with the in-network hostname.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Static bearer token protecting /api/v1 (see auth/). Required — the API
# rejects everything when unset.
API_KEY=dev-secret-key
