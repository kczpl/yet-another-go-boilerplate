# Copy this file to .env and adjust it. Do NOT commit real secrets
# (.env is gitignored).

# development | staging | production. An unset ENVIRONMENT means
# production: then DATABASE_URL is required, the session cookie is Secure,
# and responses carry HSTS.
ENVIRONMENT=development
# debug | info | warn | error (debug also logs every SQL query)
LOG_LEVEL=info

# The HTTP bind address for `just app`. Compose overrides HOST to 0.0.0.0.
HOST=localhost
PORT=8080

# docker-compose uses these host port mappings.
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# The Postgres URL. Use localhost when you run the app on the host
# (`just app`). The compose api service overrides this with the in-network
# hostname.
DATABASE_URL=postgres://app:app@localhost:5432/app
# Each connection gets statement_timeout=5s. Add the parameter to the URL
# to change it, for example ...?statement_timeout=30s (0 disables it).

# The header in which a trusted reverse proxy sends the client address.
# The rate limits read the last address in it. Leave it empty
# without such a proxy, because clients can forge the header.
# CLIENT_IP_HEADER=X-Forwarded-For

# An optional pprof and expvar listener. It must be a loopback address.
# DEBUG_ADDR=localhost:6060

# The app has two kinds of model. internal/app/models.go registers the
# providers of both. A real provider is registered only when its key is
# set. A model of a provider without a key stops the startup.
#
# The default LLM (a model that writes text) as provider/model. fake/echo
# needs no network and no key: it streams the question back.
# LLM_MODEL=fake/echo
# LLM_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=
#
# The default System One model (a model that judges a state with
# calibrated probabilities) as provider/model. fake/uniform needs no
# network and no key: it gives each option the same probability.
# SYSTEMONE_MODEL=fake/uniform
# SYSTEMONE_MODEL=typesafe/jev-latest
# TYPESAFE_API_KEY=
